{
  "name": "system_app",
  "version": "1.0.0",
  "description": "Willgrow Language Class App",
  "main": "electron/main.mjs",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on tcp:3000 && cross-env NODE_ENV=development electron .\"",
    "build": "tsc && vite build",
    "build:electron": "tsc && vite build && electron-builder -mw",
    "web:dev": "vite",
    "web:build": "tsc && vite build",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev"
  },
  "keywords": [],
  "author": "Willgrow",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.27.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^40.7.0",
    "electron-builder": "^26.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wrangler": "^4.72.0"
  },
  "dependencies": {
    "autoprefixer": "^10.4.27",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "framer-motion": "^12.35.0",
    "lucide-react": "^0.577.0",
    "postcss": "^8.5.8",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.19",
    "wait-on": "^9.0.4",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.11"
  },
  "build": {
    "appId": "com.willgrow.app",
    "directories": {
      "output": "../build_output"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  }
}
